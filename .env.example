# Template for .env.local. Copy this file to .env.local (which git ignores) and fill it in.
# Never put real values in this file: it is committed.
#
# Firebase console > Project settings > General > Your apps > (your Web app) > SDK setup and configuration.
# These values end up inside the app, where anyone can read them. That is normal for Firebase web
# settings; firestore.rules is what keeps the data safe. Secret keys never go here.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Optional.
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Optional: Google sign-in in the phone app. Firebase console > Authentication > Sign-in method >
# Google > Web SDK configuration > Web client ID.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
